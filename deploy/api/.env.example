# Optional manual setup: copy to .env, chmod 600, uncomment Compose env_file.
# Without .env, start Compose and claim through the wizard within 10 minutes.
# Generate it with: openssl rand -hex 32
API_TOKEN=
# Separate agent-only credential; at least 32 characters and different from both other tokens.
# If empty, agents need API_TOKEN and therefore hold an admin credential.
AGENT_TOKEN=
API_PORT=8080
# Separate random credential, at least 32 characters; unset disables operator routes.
OPERATOR_TOKEN=
ACTIONS_ENABLED=0
ACTIONS_HOST=
# Exact mapping only: app=/srv/app/compose.yml,db=/srv/db/compose.yml
ACTIONS_COMPOSE_FILES=
# Empty disables signed updates. Set /agent-releases only after mounting a public release tree read-only.
AGENT_RELEASE_DIR=
# Empty = promote-only. Example: host-a,host-b
AGENT_CANARY_HOSTS=
ICONS_FETCH=0

# Optional public origin behind a trusted reverse proxy.
PUBLIC_URL=
TRUSTED_PROXY=0
AGENT_BIN_DIR=/usr/share/homelab-inventory/agent
