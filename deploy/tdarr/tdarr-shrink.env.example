# Install as /etc/default/tdarr-shrink, root:tdarr-shrink, mode 0640.
# Literal KEY=value assignments only; quote JSON and values containing spaces.
TDARR_API=http://127.0.0.1:8266
TDARR_API_KEY=''
TDARR_FLOW_ID=''
TDARR_MOVIE_ROOT=/media/movies
TDARR_SERIES_ROOT=/media/series
TDARR_PATH_MAP='{"/media/movies":"/srv/media/movies","/media/series":"/srv/media/series","/data/movies":"/srv/media/movies"}'
TDARR_NODE_NAME=''
TDARR_PC_NODE=''
TDARR_CACHE_NOTE='All nodes need translated access to the same library and transcode cache.'
TDARR_ALLOWED_PREFIXES='["/media/movies","/media/series"]'
TDARR_SHRINKD_BIND=127.0.0.1
TDARR_SHRINKD_PORT=8791
TDARR_TOKEN_FILE=/etc/tdarr-shrink.token
RADARR_URL=http://127.0.0.1:7878
RADARR_API_KEY=''
RADARR_CONFIG=''
TDARR_PROTECTED_RADARR_IDS=''
APPRISE_NOTIFY=''
TDARR_STATE_DIR=/var/lib/tdarr-shrink
TDARR_LOG_FILE=/var/log/tdarr-shrink.log
